{
  "opencollection": "1.0.0",
  "info": {
    "name": "Weld REST Connection Bridge Orchestration Runs API",
    "version": "0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orchestration Runs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Orchestration Runs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://connect.weld.app/orchestration_runs",
            "params": [
              {
                "name": "starting_after",
                "value": "",
                "type": "query",
                "description": "The cursor to use in pagination. Use the value of the `next_cursor` field from the response of a previous list request."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The number of items to return in a single page."
              },
              {
                "name": "orchestration_id",
                "value": "",
                "type": "query",
                "description": "Filter runs by Orchestration ID."
              }
            ]
          },
          "docs": "List all Orchestration Runs in pages, sorted by due date in descending order (most recent first). Optionally filter by Orchestration ID."
        },
        {
          "info": {
            "name": "Get Orchestration Run",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://connect.weld.app/orchestration_runs/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the Orchestration Run."
              }
            ]
          },
          "docs": "Get a specific Orchestration Run by its ID."
        }
      ]
    }
  ],
  "bundled": true
}