{
  "opencollection": "1.0.0",
  "info": {
    "name": "Weld REST Connection Bridge ELT Streams API",
    "version": "0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "ELT Streams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List ELT Streams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://connect.weld.app/elt_streams",
            "params": [
              {
                "name": "elt_sync_id",
                "value": "",
                "type": "query",
                "description": "The Id of the ELT Sync that the stream belongs to."
              },
              {
                "name": "starting_after",
                "value": "",
                "type": "query",
                "description": "The cursor to use in pagination. Use the value of the `next_cursor` field from the response of a previous list request."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The number of items to return in a single page."
              }
            ]
          },
          "docs": "List all ELT Streams in pages sorted by their creation date."
        },
        {
          "info": {
            "name": "Get ELT Stream",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://connect.weld.app/elt_streams/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the ELT Stream."
              }
            ]
          },
          "docs": "Get details of a specific ELT Stream by its ID."
        },
        {
          "info": {
            "name": "Delete ELT Stream",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://connect.weld.app/elt_streams/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the ELT Stream to delete."
              }
            ]
          },
          "docs": "Delete ELT Stream"
        },
        {
          "info": {
            "name": "Request ELT Stream Run",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://connect.weld.app/elt_streams/:id/request_run",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the ELT Stream to run."
              }
            ]
          },
          "docs": "Attempts to run the specified ELT Stream immediately."
        },
        {
          "info": {
            "name": "Request ELT Stream Full Refresh",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://connect.weld.app/elt_streams/:id/request_full_refresh",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the ELT Stream to refresh."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Marks the next scheduled run as a full refresh. This disregards incremental sync settings and may take longer to complete."
        },
        {
          "info": {
            "name": "Cancel ELT Stream Full Refresh",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://connect.weld.app/elt_streams/:id/cancel_full_refresh",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the ELT Stream to cancel the full refresh for."
              }
            ]
          },
          "docs": "Cancels a previously requested full refresh for the ELT Stream, reverting it back to incremental sync."
        }
      ]
    }
  ],
  "bundled": true
}