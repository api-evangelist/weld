{
  "opencollection": "1.0.0",
  "info": {
    "name": "Weld REST Connection Bridge Connections API",
    "version": "0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Connections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get ELT Settings for a connection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://connect.weld.app/connections/:id/settings",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the connection that is created."
              }
            ]
          },
          "docs": "Get settings based on ELT Sync. The configuration is used when we want to create or update an ELT Sync. The connection should be already created before getting the settings."
        },
        {
          "info": {
            "name": "List Connections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://connect.weld.app/connections",
            "params": [
              {
                "name": "starting_after",
                "value": "",
                "type": "query",
                "description": "The cursor to use in pagination. Use the value of the `next_cursor` field from the response of a previous list request."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The number of items to return in a single page."
              }
            ]
          },
          "docs": "List all Connections for the current account."
        },
        {
          "info": {
            "name": "Delete Connection",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://connect.weld.app/connections/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the Connection to delete."
              }
            ]
          },
          "docs": "Deletes the specified Connection."
        }
      ]
    }
  ],
  "bundled": true
}